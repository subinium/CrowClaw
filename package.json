{
  "name": "crowclaw",
  "version": "0.6.7",
  "type": "module",
  "description": "A self-improving TypeScript agent framework that learns from every conversation.",
  "bin": {
    "crowclaw": "packages/cli/dist/index.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "packages/*/dist",
    "scripts/link-workspaces.mjs"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/link-workspaces.mjs",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "node packages/cli/dist/index.js",
    "preflight": "npm run typecheck && npm test",
    "release:check": "npm run preflight",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/sandbox": "^0.8.9"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@cloudflare/workers-types": "^4.20260411.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4",
    "wrangler": "^4.81.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subinium/CrowClaw.git"
  },
  "homepage": "https://github.com/subinium/CrowClaw",
  "bugs": {
    "url": "https://github.com/subinium/CrowClaw/issues"
  }
}
