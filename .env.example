# --- CrowClaw Environment Configuration ---

# Server port (default: 4000 for dev, 8787 for production)
PORT=4000

# --- Provider Configuration ---
# Primary provider key -- CrowClaw auto-detects provider type from the base URL.
# Set CROWCLAW_API_KEY for the framework-level key (highest priority).
CROWCLAW_API_KEY=
# Provider type: openai | anthropic | openrouter | custom
CROWCLAW_PROVIDER=openai
# Base URL for the provider API
CROWCLAW_BASE_URL=https://api.openai.com/v1
# Default model to use
CROWCLAW_MODEL=gpt-4o

# Alternative: use OpenRouter or OpenAI keys directly
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=anthropic/claude-sonnet-4
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# --- Dashboard ---
# Optional token to protect the dashboard UI. If unset, access is unrestricted.
CROWCLAW_DASHBOARD_TOKEN=
# Public URL used by reverse proxies and deployment docs.
CROWCLAW_PUBLIC_URL=

# --- Skills & Personas ---
# Directory to load local SKILL.md files from
CROWCLAW_SKILL_DIR=
# Directory to load persona files (SOUL.md, IDENTITY.md, etc.)
CROWCLAW_PERSONA_DIR=

# --- MCP Integrations ---
# GitHub token for the MCP GitHub preset
GITHUB_TOKEN=
# Brave Search API key for the MCP Brave Search preset
BRAVE_API_KEY=
