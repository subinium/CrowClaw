{
  "name": "@crowclaw/runtime-node",
  "version": "0.2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./route-paths": {
      "types": "./src/route-paths.ts",
      "import": "./dist/route-paths.js"
    },
    "./logger": {
      "types": "./src/logger.ts",
      "import": "./dist/logger.js"
    },
    "./session-mutex": {
      "types": "./src/session-mutex.ts",
      "import": "./dist/session-mutex.js"
    },
    "./event-bus": {
      "types": "./src/event-bus.ts",
      "import": "./dist/event-bus.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@crowclaw/acp": "0.2.0",
    "@crowclaw/core": "0.2.0",
    "@crowclaw/gateway": "0.2.0",
    "@crowclaw/learning": "0.2.0",
    "@crowclaw/mcp": "0.2.0",
    "@crowclaw/mcp-server": "0.2.0",
    "@crowclaw/memory": "0.2.0",
    "@crowclaw/plugins": "0.2.0",
    "@crowclaw/providers": "0.2.0",
    "@crowclaw/scheduler": "0.2.0",
    "@crowclaw/storage": "0.2.0",
    "@crowclaw/tools": "0.2.0",
    "@crowclaw/workspace": "0.2.0"
  }
}
