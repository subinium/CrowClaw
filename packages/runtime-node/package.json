{
  "name": "@crowclaw/runtime-node",
  "version": "0.1.4",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./route-paths": {
      "types": "./src/route-paths.ts",
      "import": "./dist/route-paths.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@crowclaw/core": "0.1.0",
    "@crowclaw/providers": "0.1.0",
    "@crowclaw/storage": "0.1.0",
    "@crowclaw/tools": "0.1.0",
    "@crowclaw/workspace": "0.1.0",
    "@crowclaw/scheduler": "0.1.0",
    "@crowclaw/learning": "0.1.0",
    "@crowclaw/mcp": "0.1.0",
    "@crowclaw/mcp-server": "0.1.0",
    "@crowclaw/plugins": "0.1.0"
  }
}
