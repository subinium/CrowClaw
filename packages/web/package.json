{
  "name": "@crowclaw/web",
  "version": "0.4.3",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite --config ui/vite.config.mjs",
    "build:ui": "vite build --config ui/vite.config.mjs",
    "build:html": "node ../../scripts/build-dashboard.mjs"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
